# Copie este arquivo para ".env" e preencha com valores reais.
# NUNCA commite o ".env" real (já está no .gitignore da raiz do projeto).

# --- Aplicação -----------------------------------------------------------
NODE_ENV=development
PORT=3000

# Habilita/desabilita o Swagger explicitamente. Se omitido, o padrão é
# "habilitado sempre que NODE_ENV !== production".
# ENABLE_SWAGGER=true

# --- Banco de dados (Postgres local ou hospedado; sem Docker) ------------
# Formato: postgres://usuario:senha@host:porta/nome_do_banco
DATABASE_URL=postgres://postgres:postgres@localhost:5432/central_performance

# --- Autenticação ----------------------------------------------------------
# Segredo do JWT de access token (curta duração, ~15min). Use um valor
# aleatório de pelo menos 32 caracteres. Nunca reaproveite entre ambientes.
ACCESS_TOKEN_SECRET=troque-por-um-valor-aleatorio-de-pelo-menos-32-caracteres
# Duração do access token em segundos (padrão: 900 = 15 minutos).
ACCESS_TOKEN_TTL_SECONDS=900

# Duração (em dias) dos refresh tokens antes de expirarem.
REFRESH_TOKEN_TTL_DAYS=30

# --- Criptografia de credenciais (genérico, multi-marketplace) -----------
# Chave AES-256-GCM: deve decodificar para EXATAMENTE 32 bytes.
# Aceita dois formatos:
#   - hex: exatamente 64 caracteres hexadecimais (0-9, a-f)
#   - base64: uma string base64 que decodifique para 32 bytes
# Gere uma com, por exemplo: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CREDENTIAL_ENCRYPTION_KEY=troque-por-32-bytes-em-hex-ou-base64

# --- CORS / cookies --------------------------------------------------------
# Origem única do frontend (necessária para CORS com credentials: true).
FRONTEND_URL=http://localhost:3001

# "true" em produção (HTTPS); "false" em desenvolvimento local (HTTP).
COOKIE_SECURE=false

# --- Rate limiting (opcional; possuem defaults sensatos) ------------------
# THROTTLE_TTL_MS=60000
# THROTTLE_LIMIT=100

# --- Seed do primeiro usuário admin (usado apenas por "npm run seed:admin")
# Não possuem valor padrão: o script falha se não forem definidas.
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=troque-por-uma-senha-forte

# --- Mercado Livre OAuth (Fase 2) ------------------------------------------
# Segredos da aplicação cadastrada no DevCenter do Mercado Livre. Sem valor
# padrão — a aplicação falha ao subir sem eles.
ML_CLIENT_ID=troque-pelo-app-id-do-devcenter
ML_CLIENT_SECRET=troque-pelo-secret-key-do-devcenter
# Deve corresponder EXATAMENTE ao caminho fixo do callback do backend,
# incluído o domínio configurado no app do DevCenter. HTTPS obrigatório em
# qualquer ambiente exceto NODE_ENV=development (onde HTTP é aceito).
ML_REDIRECT_URI=https://api.example.com/integrations/mercado-livre/callback

# --- Timing operacional do OAuth (opcionais; possuem defaults sensatos) ---
# ML_HTTP_TIMEOUT_MS=10000
# ML_ACCOUNT_LOCK_WAIT_MS=3000
# ML_OAUTH_PROCESSING_STALE_AFTER_MS=120000
# ML_TOKEN_REFRESH_LEEWAY_MS=900000

# --- Amazon SP-API (Fase 4, fundação — aplicação privada) ------------------
# Nenhuma tem valor padrão nem é obrigatória: o backend sobe normalmente sem
# elas. Só a renovação de access token Amazon falha em runtime, com o erro
# fechado AMAZON_NOT_CONFIGURED, até que sejam preenchidas com os valores
# reais obtidos no Seller Central / Developer Console da própria empresa
# (ver docs/amazon-sp-api-private-app-setup.md). NUNCA preencha com
# credenciais reais neste arquivo de exemplo — só no ".env" real.
# AMAZON_SP_API_APP_ID=troque-pelo-application-id-do-app-privado
# AMAZON_LWA_CLIENT_ID=troque-pelo-lwa-client-id
# AMAZON_LWA_CLIENT_SECRET=troque-pelo-lwa-client-secret
# Um dos três endpoints regionais oficiais (allowlist fechada em
# amazon-sp-api-endpoint.allowlist.ts): sellingpartnerapi-na, -eu ou -fe.
# AMAZON_SP_API_ENDPOINT=https://sellingpartnerapi-na.amazon.com
# AMAZON_SP_API_USER_AGENT=CentralPerformance/1.0 (Language=TypeScript)
