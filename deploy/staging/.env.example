# Checkpoint CP2K-6B-2B — só nomes, comentários seguros e placeholders.
# NUNCA colocar valor real aqui. Copie para um arquivo local fora do
# controle de versão (ex.: deploy/staging/.env.local, já coberto pelo
# .gitignore por ser um ".env*") antes de preencher.

# --- Hosts (domínio de avaliação, subdomínios do MESMO domínio
# registrável — necessário para cookie SameSite=Lax entre frontend/backend
# funcionar em subdomínios diferentes) -----------------------------------
FRONTEND_HOST=avaliacao.exemplo.com
BACKEND_HOST=api-avaliacao.exemplo.com

# --- Portas públicas do Caddy (únicas portas publicadas no host) --------
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443

# --- PostgreSQL (rede interna, nunca publicado no host) ------------------
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# --- Autenticação ----------------------------------------------------------
# >= 32 caracteres, gerado só para este ambiente (nunca reaproveitar
# segredo de outro ambiente).
ACCESS_TOKEN_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# --- Criptografia ------------------------------------------------------
# 32 bytes em hex (64 caracteres) ou base64. Gerar com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CREDENTIAL_ENCRYPTION_KEY=

# --- Mercado Livre (OAuth) ----------------------------------------------
ML_CLIENT_ID=
ML_CLIENT_SECRET=
ML_REDIRECT_URI=https://api-avaliacao.exemplo.com/integrations/mercado-livre/callback

# --- Shopee (Sandbox — este ambiente usa SOMENTE Sandbox até aprovação) --
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=
SHOPEE_HTTP_TIMEOUT_MS=10000
SHOPEE_TOKEN_REFRESH_SKEW_SECONDS=600

# --- Workers (throttle) -------------------------------------------------
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100

# --- Usuário revisor (criado manualmente via `seed-reviewer`, nunca no
# boot automático) -------------------------------------------------------
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# As seguintes configurações NÃO entram aqui: ficam fixas com segurança
# diretamente no compose.yml (NODE_ENV=production, COOKIE_SECURE=true,
# ENABLE_SWAGGER=false, MARKETPLACE_AUTO_SYNC_ENABLED=false,
# BACKFILL_WORKER_ENABLED=false, SHOPEE_ENVIRONMENT=SANDBOX).
